#!/bin/sh
# Kör direkt med /bin/sh — INTE #!/usr/bin/with-contenv … (ger "unable to exec bashio/bash/sh").
# s6 longrun ärvde normalt alla container-/Supervisor-variabler från PID 1.
set -eu
export PYTHONUNBUFFERED=1

cd /app || {
  echo "[perplexity-mcp-bridge] ERROR: cannot cd to /app" >&2
  exit 1
}

echo "[perplexity-mcp-bridge] Starting uvicorn on 0.0.0.0:8099"

exec python -m uvicorn src.main:app --host 0.0.0.0 --port 8099 --proxy-headers --forwarded-allow-ips='*'
