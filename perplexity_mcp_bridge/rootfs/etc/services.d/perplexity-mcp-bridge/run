#!/usr/bin/with-contenv bash
# ==============================================================================
# Perplexity MCP Bridge — s6 longrun. Använd bash som interpreter; "bashio" är
# inte en körbar fil (fel: unable to exec bashio).
# ==============================================================================
set -euo pipefail
export PYTHONUNBUFFERED=1

cd /app || {
  echo "[perplexity-mcp-bridge] ERROR: cannot cd to /app" >&2
  exit 1
}

echo "[perplexity-mcp-bridge] Starting uvicorn on 0.0.0.0:8099"

exec python -m uvicorn src.main:app \
  --host 0.0.0.0 \
  --port 8099 \
  --proxy-headers \
  --forwarded-allow-ips='*'
